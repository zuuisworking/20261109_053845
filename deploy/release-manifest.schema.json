{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigap.ulp-labuhan.local/schemas/release-manifest.schema.json",
  "title": "SIGAP production release manifest",
  "description": "The approved record that ties a production rollout to an exact source revision, an exact set of image digests, a bundle checksum, the evaluated security and contract exceptions, and a named approval. The manifest is signed with a detached signature; the signature is verified with RELEASE_MANIFEST_PUBLIC_KEY before rollout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "releaseId",
    "sourceSha",
    "generatedAt",
    "expiresAt",
    "images",
    "bundle",
    "approvals",
    "exceptionSummary"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 3,
      "description": "Human readable release identifier, for example sigap-20261127T101500Z-a1b2c3d4e5f6."
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact 40 character commit SHA of the deployed revision."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Approval expiry. The manifest is rejected after this instant."
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "mongo", "caddy"],
      "properties": {
        "backend": { "$ref": "#/$defs/digestReference" },
        "frontend": { "$ref": "#/$defs/digestReference" },
        "mongo": { "$ref": "#/$defs/digestReference" },
        "caddy": { "$ref": "#/$defs/digestReference" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "approver", "approvedAt"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "approver": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "exceptionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerabilityExceptions", "licenseExceptions", "contractExceptions"],
      "properties": {
        "vulnerabilityExceptions": { "type": "integer", "minimum": 0 },
        "licenseExceptions": { "type": "integer", "minimum": 0 },
        "contractExceptions": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "digestReference": {
      "type": "string",
      "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
    }
  }
}
