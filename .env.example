# Runtime
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sigap_ulp_labuhan

# Docker Compose database bootstrap. The root credential is used only by the
# MongoDB initializer and must not be supplied to the backend.
MONGO_ROOT_USERNAME=sigap_root
MONGO_ROOT_PASSWORD=replace-with-a-random-bootstrap-password
MONGO_DATABASE=sigap_ulp_labuhan
MONGO_APP_USERNAME=sigap_app
MONGO_APP_PASSWORD=replace-with-a-random-application-password
MONGO_BACKUP_USERNAME=sigap_backup
MONGO_BACKUP_PASSWORD=replace-with-a-random-backup-password
MONGO_RESTORE_DATABASE=sigap_ulp_labuhan_restore
MONGO_RESTORE_USERNAME=sigap_restore
MONGO_RESTORE_PASSWORD=replace-with-a-random-restore-password
# URL-encode special characters in each password.
COMPOSE_MONGODB_URI=mongodb://sigap_app:replace-with-a-random-application-password@mongo:27017/sigap_ulp_labuhan?authSource=sigap_ulp_labuhan
LOG_LEVEL=info
TRUST_PROXY=1

# Production images must be immutable. Set each value to an approved
# `image:tag@sha256:<digest>` reference before deployment.
MONGO_IMAGE=mongo:8.0
CADDY_IMAGE=caddy:2.9.1-alpine

# Exact browser origins allowed to use credentialed API requests.
# Use a comma-separated list for additional deployments.
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173

# Generate an independent random value of at least 32 bytes for every deployment.
# Replace the placeholder before starting the service. Do not reuse example values.
# The API runtime does not read a CSRF secret: every session receives an
# independent random token whose SHA-256 hash is stored server-side.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SESSION_TTL_HOURS=8

# One-time CLI provisioning. The password is intentionally absent.
INITIAL_ADMIN_ID=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# Optional Google Apps Script JSON endpoint. Leave empty to disable guest sync.
GOOGLE_FORM_APPS_SCRIPT_URL=

# Dedicated request-rate ceiling for POST /api/v1/guests/sync, counted per
# authenticated user and trusted client address. Concurrent sync requests are
# coalesced into one active upstream fetch and database upsert.
GUEST_SYNC_RATE_LIMIT_MAX=10
GUEST_SYNC_RATE_LIMIT_WINDOW_MS=60000

# Persistent avatar storage
UPLOAD_DIR=./storage/uploads

# Export resource guards. EXPORT_MAX_BYTES bounds the generated CSV/XLSX file
# size (default 64 MiB) in addition to the 100,000-row ceiling.
# EXPORT_MAX_CONCURRENT bounds how many exports may be generated at the same
# time; requests above the limit fail fast with 429 RATE_LIMITED.
EXPORT_MAX_BYTES=67108864
EXPORT_MAX_CONCURRENT=2
